# Application configuration
APP_NAME="Nadafpinjar Portal"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings
# PostgreSQL Configuration
POSTGRES_USER=nadaf_user
POSTGRES_PASSWORD=nadaf_password
POSTGRES_DB=nadaf_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword
MONGO_URI=mongodb+srv://rakesh_rk:Rakesh2005@faceauth.jvni6bv.mongodb.net/nadaf_census?appName=faceauth

# Redis Configuration
REDIS_HOST=localhost
