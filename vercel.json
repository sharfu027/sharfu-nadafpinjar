{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/donations",
      "dest": "/api/donations.js"
    },
    {
      "src": "/accountsummary",
      "dest": "/nadafpinjar/accountsummary.html"
    },
    {
      "src": "/Beneficiaries",
      "dest": "/nadafpinjar/Beneficiaries.html"
    },
    {
      "src": "/Paymentsandtransfers",
      "dest": "/nadafpinjar/Paymentsandtransfers.html"
    },
    {
      "src": "/Receipts",
      "dest": "/nadafpinjar/Receipts.html"
    },
    {
      "src": "/associatedtransfers",
      "dest": "/nadafpinjar/associatedtransfers.html"
    },
    {
      "src": "/Statements",
      "dest": "/nadafpinjar/Statements.html"
    },
    {
      "src": "/Security",
      "dest": "/nadafpinjar/Security.html"
    },
    {
      "src": "/viewReceipt",
      "dest": "/nadafpinjar/viewReceipt.html"
    },
    {
      "src": "/(.*)",
      "dest": "/nadafpinjar/$1"
    }
  ]
}
