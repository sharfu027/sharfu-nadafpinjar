# Application configuration
APP_NAME="Nadafpinjar Portal"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings
# PostgreSQL Configuration
POSTGRES_USER=nadaf_user
POSTGRES_PASSWORD=nadaf_password
POSTGRES_DB=nadaf_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword
MONGO_URI=mongodb://127.0.0.1:27017/nadaf_census

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security (JWT Auth)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Third-Party API Credentials
# Razorpay payment keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS & Email Services
SMS_API_KEY=your_sms_api_key
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email_smtp_user
EMAIL_SMTP_PASSWORD=your_email_smtp_password

# AI & Face Verification
MIN_LIVENESS_CONFIDENCE=0.85
FACE_RECOGNITION_THRESHOLD=0.60
